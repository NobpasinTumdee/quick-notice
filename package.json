{
  "name": "kawaii-wellness-companion",
  "version": "1.0.0",
  "private": true,
  "description": "A kawaii mascot that reminds you to drink, stretch, sit up straight and rest your eyes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && node scripts/generate-sounds.mjs && tsc --noEmit && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sounds": "node scripts/generate-sounds.mjs",
    "test": "node --import ./scripts/ts-resolve.mjs --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
